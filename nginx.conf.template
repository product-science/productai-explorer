server {
    listen       5173;
    listen  [::]:5173;
    server_name  localhost;

    # Serve static assets from root as well (convenience)
    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Dashboard specific routing (since Vite base is /dashboard)
    location /dashboard {
        alias /usr/share/nginx/html;
        try_files $uri $uri/ /dashboard/index.html;
    }

    # Proxy API requests
    location /api/ {
        resolver 127.0.0.11 valid=30s;
        set $api_endpoint ${API_ENDPOINT};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_endpoint;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /rpc/ {
        resolver 127.0.0.11 valid=30s;
        set $rpc_endpoint ${RPC_ENDPOINT};
        rewrite ^/rpc/(.*)$ /$1 break;
        proxy_pass $rpc_endpoint;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
